NEXT_PUBLIC_SITE_URL=https://mycubacash.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SANCTIONS_PROVIDER=unconfigured
CRYPTO_PROVIDER=unconfigured
APP_ENV=development

# Public mycubacash communication channels. These values may be replaced per deployment.
NEXT_PUBLIC_WHATSAPP_PRIMARY_DISPLAY=+1 281-662-8581
NEXT_PUBLIC_WHATSAPP_PRIMARY_E164=12816628581
NEXT_PUBLIC_WHATSAPP_SECONDARY_DISPLAY=+1 678-346-6284
NEXT_PUBLIC_WHATSAPP_SECONDARY_E164=16783466284
NEXT_PUBLIC_PHONE_DISPLAY=+1 281-662-8581
NEXT_PUBLIC_PHONE_E164=+12816628581

# Sofia multichannel intake. Keep secret credentials server-side only.
SOFIA_INGEST_SECRET=
SOFIA_WHATSAPP_PROVIDER=unconfigured
SOFIA_VOICE_PROVIDER=unconfigured

# Application Brain / Agentic Command Network
# Use a production model endpoint and server-side API key. Never expose the key to the browser.
AGENT_MODEL_ENDPOINT=
AGENT_MODEL_API_KEY=
AGENT_MODEL_FAST=
AGENT_MODEL_REASONING=
AGENT_MODEL_HIGH_ASSURANCE=

# Autonomous workers remain off until trusted server credentials, scheduling and approval paths are configured.
AUTONOMY_WORKER_ENABLED=false
